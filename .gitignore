# ── secrets ───────────────────────────────────────────────────────────────────
# .env holds the admin password, the session signing key and the model API key.
# It is generated by install.py and must never be committed.
.env
.env.bak-*
*.env.bak-*

# ── runtime data ──────────────────────────────────────────────────────────────
# Accounts, password hashes, conversations, uploads and the admin-editable
# config all live here. This is family data; it does not belong in a repo.
data/
/auth/
/chats/
/characters/
/uploads/
/config/

# ── local backups an operator may leave behind ────────────────────────────────
*.bak-*
*.badseed-*
*.tar.gz

# ── python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ── editors / os ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ── internal build notes, not part of the published project ───────────────────
CONTRACT.md
CONTRACT-presets.md
